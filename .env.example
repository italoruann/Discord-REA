# Copie para .env na VPS (o .env nao vai para o git) e gere os segredos com: openssl rand -hex 32

# Token da API de convites
REA_ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Espaco total para anexos, em MB (o disco de 50 GB e dividido com o gendata.tech)
FILES_QUOTA_MB=10240

# TURN (coturn). Deixe TURN_SECRET vazio para nao usar TURN.
TURN_HOST=discord.gendata.tech
TURN_SECRET=
